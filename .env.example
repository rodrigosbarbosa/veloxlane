# VeloxLane monorepo — environment contract (§06 dev guide).
# Copy to .env.local for local development. Never commit real secrets.

# ─────────── App / environment ───────────
APP_ENV=local
# Local dev (web default port). Staging Vercel: https://staging.veloxlane.com
NEXT_PUBLIC_APP_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# ─────────── Supabase — auth, Postgres, storage, realtime, edge fns ───────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─────────── Stripe — platform fees + Stripe Identity (KYC) ───────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─────────── Escrow.com — licensed escrow for vehicle funds (NEVER our account) ───────────
ESCROW_API_BASE=https://api.escrow-sandbox.com
ESCROW_API_EMAIL=
ESCROW_API_KEY=
ESCROW_WEBHOOK_SECRET=

# ─────────── CARFAX — vehicle history on VIN (partner contract) ───────────
CARFAX_API_BASE=
CARFAX_PARTNER_ID=
CARFAX_API_KEY=

# ─────────── Marketcheck — fair-market pricing ───────────
MARKETCHECK_API_BASE=https://mc-api.marketcheck.com/v2
MARKETCHECK_API_KEY=

# ─────────── NHTSA vPIC — recalls + VIN decode (free, no key) ───────────
NHTSA_API_BASE=https://vpic.nhtsa.dot.gov/api

# ─────────── Twilio — SMS OTP + web→mobile handoff link ───────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

# ─────────── AWS — S3 photo storage + Rekognition + CloudFront ───────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_LISTINGS_ORIGINAL_BUCKET=listings-photos-original
S3_LISTINGS_PROCESSED_BUCKET=listings-photos-processed
# Legacy aliases still supported by server code:
S3_PHOTOS_BUCKET=veloxlane-listings-photos-original
S3_PHOTOS_PROCESSED_BUCKET=veloxlane-listings-photos-processed
CLOUDFRONT_PHOTOS_DOMAIN=

# ─────────── Plate detection — detection-only (cover the plate, never OCR it) ───────────
PLATE_DETECTOR=platerec
PLATE_RECOGNIZER_API_TOKEN=
PLATE_RECOGNIZER_SDK_URL=
PLATE_DETECTOR_URL=

# ─────────── Google Maps — geocode + proximity + map render ───────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# ─────────── Resend — transactional email (SERVER ONLY) ───────────
# API: welcome email + future app notifications via apps/web/lib/email/resend.ts
# Supabase Auth (confirm, reset, magic link): Project Settings → Authentication →
# SMTP Settings → Custom SMTP — host smtp.resend.com, port 465 or 587, user resend,
# password = RESEND_API_KEY. See docs/setup/resend.md.
RESEND_API_KEY=
# Staging/test: VeloxLane <onboarding@resend.dev> (Resend test domain)
# Production: VeloxLane <hello@veloxlane.com> (requires veloxlane.com verified in Resend)
RESEND_FROM_EMAIL=VeloxLane <onboarding@resend.dev>

# ─────────── Push — Expo EAS + APNs (iOS) + FCM (Android) ───────────
EXPO_ACCESS_TOKEN=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=

# ─────────── Web→Mobile handoff — signs single-use draft tokens ───────────
HANDOFF_TOKEN_SECRET=

# ─────────── Monitoring & analytics ───────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=

# ─────────── Affiliates — Phase 2/3 referral IDs ───────────
ENDURANCE_AFFILIATE_ID=
CARCHEX_AFFILIATE_ID=
CARSHIELD_AFFILIATE_ID=
LIGHTSTREAM_PARTNER_ID=
CAPITALONE_AUTO_PARTNER_ID=
