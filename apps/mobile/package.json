{
  "name": "@veloxlane/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "VeloxLane Expo mobile app",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform web",
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/metro-runtime": "~3.2.3",
    "@hookform/resolvers": "^3.9.1",
    "@veloxlane/auth": "workspace:*",
    "@veloxlane/brand": "workspace:*",
    "@veloxlane/db": "workspace:*",
    "@veloxlane/schemas": "workspace:*",
    "expo": "~51.0.39",
    "expo-asset": "~10.0.10",
    "expo-font": "~12.0.10",
    "expo-local-authentication": "~14.0.1",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.24",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "lucide-react-native": "^0.511.0",
    "nativewind": "^4.1.23",
    "react-native-css-interop": "^0.1.22",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-hook-form": "^7.54.2",
    "react-native-web": "~0.19.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@veloxlane/config": "workspace:*",
    "eslint": "^9.17.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
